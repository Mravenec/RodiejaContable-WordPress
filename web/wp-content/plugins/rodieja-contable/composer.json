{
  "name": "rodieja/rodieja-contable",
  "description": "Neutral WordPress plugin scaffold with native DI, SOLID layers, and security defaults.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "Rodieja\\Contable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Rodieja\\Contable\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpcs": "phpcs --standard=WordPress,WordPress-Extra src harness-plugin.php uninstall.php",
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
