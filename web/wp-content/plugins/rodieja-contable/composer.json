{
  "name": "rodieja/rodieja-contable",
  "description": "Rodieja Contable — native WordPress plugin (CPT, taxonomies, roles, REST).",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "Rodieja\\Contable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Rodieja\\Contable\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
